POSTGRES_USER=change_me
POSTGRES_PASSWORD=replace-before-use
POSTGRES_DB=change_me
DATABASE_URL=postgresql://change_me:replace-before-use@127.0.0.1:5433/change_me
# Production migrations use Neon's direct (non-pooler) connection URL.
DATABASE_URL_UNPOOLED=
AUTH_SECRET=replace-with-a-generated-32-plus-character-secret
DEMO_USERNAME=demo.supervisor
DEMO_PASSWORD=replace-before-use
DEMO_ROLE=supervisor

# Local development may leave these blank and use the local upload directory.
# Vercel deployments require a persistent S3-compatible bucket.
AWS_REGION=
AWS_ENDPOINT_URL_S3=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_UPLOADS_DIR=.local/uploads

# Keep the Groq key in a Vercel Secret; never add a real key to this file.
MODEL_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_BASE_URL=
LM_STUDIO_BASE_URL=http://127.0.0.1:1235/v1
